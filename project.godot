; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="comfy-jam-winter-2025"
run/main_scene="uid://bxcow45rq6qbu"
config/features=PackedStringArray("4.5", "C#", "GL Compatibility")
config/icon="res://Assets/Sprites/icon.svg"

[autoload]

PackedSceneRepository="*res://Scenes/Autoloads/PackedSceneRepository.tscn"
